#!/bin/bash
# Monster Network Fix: runs the usual internet repairs in order and stops as soon as you're back online.
#
#   monster-netfix          run the repairs (needs root: the button uses pkexec)
#   monster-netfix check    prints "online", "no-dns" or "offline" (no root needed)
#
# Each step prints one line: "OK <what>", "FIX <what>" or "FAIL <what>". The button shows these.

set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

check() {
    if ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 || ping -c1 -W2 8.8.8.8 >/dev/null 2>&1; then
        if getent hosts one.one.one.one >/dev/null 2>&1 || getent hosts google.com >/dev/null 2>&1; then
            echo online
        else
            echo no-dns
        fi
    else
        echo offline
    fi
}

if [ "${1:-}" = check ]; then check; exit 0; fi
[ "$(id -u)" = 0 ] || { echo "FAIL needs root (use pkexec)"; exit 1; }

done_if_online() {
    if [ "$(check)" = online ]; then
        echo "OK You're back online"
        logger -t monster-netfix "Network fixed at step: $1"
        exit 0
    fi
}

wait_for_link() {   # give NetworkManager up to $1 seconds to reconnect
    for _ in $(seq 1 "$1"); do
        nmcli -t -f STATE general 2>/dev/null | grep -qx connected && return 0
        sleep 1
    done
    return 1
}

logger -t monster-netfix "Network repair started"

# 0. Already fine?
if [ "$(check)" = online ]; then echo "OK Internet is already working"; exit 0; fi

# 1. Undo Monster Lockdown if it's on
if [ "$(cat /run/monster-lockdown/state 2>/dev/null)" = locked ] && command -v monster-lockdown >/dev/null; then
    monster-lockdown off >/dev/null 2>&1 && echo "FIX Turned off Monster Lockdown"
    wait_for_link 10; done_if_online lockdown
fi

# 2. Firewall emergency mode
if firewall-cmd --query-panic >/dev/null 2>&1; then
    firewall-cmd --panic-off >/dev/null 2>&1 && echo "FIX Turned off firewall emergency mode"
    done_if_online panic
else
    echo "OK Firewall is normal"
fi

# 3. Airplane mode / Wi-Fi switched off
if rfkill list wifi 2>/dev/null | grep -q "Soft blocked: yes"; then
    rfkill unblock wifi && echo "FIX Turned off airplane mode for Wi-Fi"
fi
if rfkill list wifi 2>/dev/null | grep -q "Hard blocked: yes"; then
    echo "FAIL Wi-Fi is switched off by a hardware switch or key (look for an airplane or Wi-Fi key)"
fi

# 4. Networking or Wi-Fi turned off in NetworkManager
if nmcli networking 2>/dev/null | grep -q disabled; then
    nmcli networking on && echo "FIX Turned networking back on"
fi
if nmcli radio wifi 2>/dev/null | grep -q disabled; then
    nmcli radio wifi on && echo "FIX Turned Wi-Fi back on"
fi
wait_for_link 15 && echo "OK Connected to your network" ; done_if_online networking-on

# 4b. VPN: NordVPN's kill switch blocks everything while the VPN is disconnected
as_user() {
    local uid="${PKEXEC_UID:-${SUDO_UID:-}}"
    if [ -n "$uid" ] && [ "$uid" != 0 ]; then runuser -u "$(id -nu "$uid")" -- "$@"; else "$@"; fi
}
if command -v nordvpn >/dev/null; then
    vstat=$(as_user nordvpn status 2>/dev/null)
    vset=$(as_user nordvpn settings 2>/dev/null)
    if ! echo "$vstat" | grep -qi "status: connected"; then
        if echo "$vset" | grep -qi "kill switch: enabled"; then
            echo "OK Found it: NordVPN's kill switch blocks the internet while the VPN is off"
        fi
        for _ in 1 2 3; do as_user nordvpn connect >/dev/null 2>&1 && break; sleep 3; done
        if as_user nordvpn status 2>/dev/null | grep -qi "status: connected"; then
            echo "FIX Reconnected NordVPN"
        elif echo "$vset" | grep -qi "kill switch: enabled"; then
            echo "FAIL NordVPN couldn't reconnect, and its kill switch keeps the internet blocked. Open NordVPN and connect, or log in to NordVPN again"
        fi
        sleep 2; done_if_online nordvpn
    else
        echo "OK NordVPN is connected"
    fi
fi

# 5. Stale DNS
if [ "$(check)" = no-dns ]; then
    resolvectl flush-caches >/dev/null 2>&1
    systemctl restart systemd-resolved >/dev/null 2>&1 && echo "FIX Reset the name lookup (DNS) service"
    sleep 2; done_if_online dns
fi

# 6. Renew the connection on every network device that's up
for dev in $(nmcli -t -f DEVICE,STATE device 2>/dev/null | awk -F: '$2 ~ /^connected/ {print $1}'); do
    nmcli device reapply "$dev" >/dev/null 2>&1 && echo "FIX Refreshed the connection on $dev"
done
sleep 3; done_if_online reapply

# 7. Restart NetworkManager (reconnects everything that was connected before)
systemctl restart NetworkManager >/dev/null 2>&1 && echo "FIX Restarted the network service"
wait_for_link 25 && echo "OK Reconnected to your network"
sleep 2; done_if_online nm-restart

# 8. Bring up any saved connection that should connect automatically
for con in $(nmcli -t -f NAME,AUTOCONNECT connection show 2>/dev/null | awk -F: '$2=="yes" {print $1}' | grep -v '^lo$'); do
    nmcli connection up "$con" >/dev/null 2>&1 && { echo "FIX Connected to $con"; break; }
done
sleep 3; done_if_online connection-up

# Still not working: say what's left
case "$(check)" in
    no-dns)  echo "FAIL Connected, but websites can't be found (DNS). Try again, or set DNS to 1.1.1.1 in network settings" ;;
    *)       if nmcli -t -f STATE general 2>/dev/null | grep -qx connected; then
                 echo "FAIL Connected to your network, but the internet isn't reachable. Restart your router or check your VPN"
             else
                 echo "FAIL Couldn't connect to any network. Check the cable or pick your Wi-Fi in the network menu"
             fi ;;
esac
logger -t monster-netfix "Network repair finished without success"
exit 1
