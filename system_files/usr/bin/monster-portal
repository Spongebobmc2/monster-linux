#!/usr/bin/python3
# Monster Portal: Bazzite's Portal app (yafti_gtk.py) with the Monster "Slime Pop" look.
# It runs the very same Portal code and only adds the Monster name, header and style on top.
import importlib.machinery, importlib.util, os, sys

SRC = "/usr/libexec/yafti_gtk_bazzite.py"   # Bazzite's Portal code (moved here by the build)
if not os.path.exists(SRC):
    SRC = "/usr/bin/yafti_gtk.py"
DIR = "/usr/share/monster-linux/portal"
if not os.path.exists(SRC):
    sys.exit("Monster Portal: the Portal app (yafti_gtk.py) is not installed.")

loader = importlib.machinery.SourceFileLoader("yafti_gtk", SRC)
spec = importlib.util.spec_from_loader("yafti_gtk", loader)
y = importlib.util.module_from_spec(spec)
loader.exec_module(y)

from gi.repository import Gtk  # version already chosen by the Portal code

y.APP_TITLE = "Monster Portal"
y.DEFAULT_ACCENT = "#3f7a0e"
try:
    y.AUTOSTART_CONTENT = y.AUTOSTART_CONTENT.replace("yafti_gtk.py", "monster-portal").replace("Bazzite Portal", "Monster Portal")
except Exception:
    pass

def os_version():
    try:
        for line in open("/usr/lib/os-release"):
            if line.startswith("VERSION="):
                return line.split("=", 1)[1].strip().strip('"').split(" ")[0]
    except Exception:
        pass
    return ""

_orig_init = y.YaftiGTK.__init__
def _monster_init(self, *a, **k):
    _orig_init(self, *a, **k)
    try:
        self.set_title("Monster Portal")
        self.set_default_size(900, 660)
        self.add_css_class("monster-portal")
        css = Gtk.CssProvider()
        css.load_from_path(os.path.join(DIR, "slime-pop.css"))
        Gtk.StyleContext.add_provider_for_display(self.get_display(), css, Gtk.STYLE_PROVIDER_PRIORITY_USER)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        head.add_css_class("monster-header")
        pic = Gtk.Image.new_from_file(os.path.join(DIR, "gloop.png"))
        pic.set_pixel_size(60)           # keeps Gloop small in the header
        pic.set_valign(Gtk.Align.CENTER)
        head.append(pic)
        words = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        words.set_valign(Gtk.Align.CENTER)
        words.set_hexpand(True)
        t = Gtk.Label(label="Monster Portal", xalign=0); t.add_css_class("monster-title")
        s = Gtk.Label(label="Every button does one job. Pick what you need.", xalign=0); s.add_css_class("monster-sub")
        words.append(t); words.append(s)
        head.append(words)
        ver = os_version()
        if ver:
            v = Gtk.Label(label="MONSTER LINUX " + ver); v.add_css_class("monster-ver"); v.set_valign(Gtk.Align.CENTER)
            head.append(v)
        drip = Gtk.Box(); drip.add_css_class("monster-drip"); drip.set_size_request(-1, 14)

        box = self.get_child()
        box.prepend(drip)
        box.prepend(head)
    except Exception as e:  # the look must never stop the Portal from opening
        print("Monster Portal look not applied:", e, file=sys.stderr)
y.YaftiGTK.__init__ = _monster_init

# Green button = "press this". Bazzite lights up the button for the CURRENT state, so a program
# that isn't installed shows a green "Uninstall". Monster Linux lights up the next step instead:
# not installed -> Install is green; already installed -> nothing is green.
_NOT_YET = {"uninstall": "install", "disable": "enable", "disabled": "enable", "not-installed": "install", "remove": "add"}
_orig_hl = y.YaftiGTK.option_is_highlighted
def _monster_hl(self, option, status_token):
    try:
        tok = (status_token or "").strip().lower()
        oid = (option.get("id") or "").strip().lower()
        if tok in _NOT_YET:
            return oid == _NOT_YET[tok]
        if tok in ("install", "enable", "enabled", "installed", "add"):
            return False
    except Exception:
        pass
    return _orig_hl(self, option, status_token)
y.YaftiGTK.option_is_highlighted = _monster_hl

sys.argv[0] = "monster-portal"
y.main()
