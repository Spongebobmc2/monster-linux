#!/usr/bin/bash
# Small one-time repairs for each user after a Monster Linux update (runs at login).
# Step 1: Monster apps (Portal and its pop-ups) stay solid, never see-through.
RX='^(?!steam_app|steam|gamescope|xwaylandvideobridge|plasmawindowed|.*plasmawindowed|io\.github\.ublue_os\.yafti_gtk|.*yafti.*|org\.monsterlinux\..*|org\.kde\.konsole|konsole|.*\.exe).*'
if [ "$(kreadconfig6 --file kwinrulesrc --group monster-glass --key Description)" != "" ] \
   && [ "$(kreadconfig6 --file kwinrulesrc --group monster-glass --key wmclass)" != "$RX" ]; then
  kwriteconfig6 --file kwinrulesrc --group monster-glass --key wmclass "$RX"
  Q=$(command -v qdbus6 || command -v qdbus || true)
  [ -n "$Q" ] && $Q org.kde.KWin /KWin reconfigure >/dev/null 2>&1
fi
# Step 2: an old Portal autostart entry (written by the Bazzite Portal itself) opens Monster Portal instead.
A="$HOME/.config/autostart/bazzite-portal.desktop"
[ -f "$A" ] && sed -i -E 's@^Exec=(/usr/bin/)?yafti_gtk\.py@Exec=/usr/bin/monster-portal@; s@^Name=.*@Name=Monster Portal@' "$A"
# Step 3: keep the firewall on your chosen place (Home unless you picked Public). No password needed.
SH=/usr/share/plasma/plasmoids/org.monsterlinux.shield/contents/code/shield.sh
[ -x "$SH" ] && bash "$SH" ensure >/dev/null 2>&1
exit 0
